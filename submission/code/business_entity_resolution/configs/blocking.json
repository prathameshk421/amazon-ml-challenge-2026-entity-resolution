{
  "norm_version": "2.1",
  "max_workers": 14,
  "abbrev_mining": {
    "enabled": true,
    "min_frac": 0.0005,
    "short_max_len": 4,
    "cos_min": 0.95,
    "target_min_frac": 0.001,
    "sample": 1500000,
    "min_country_records": 50000,
    "seed": 0
  },
  "families": [
    "EN",
    "NT",
    "NG",
    "NP",
    "SP",
    "NC",
    "AT",
    "AB",
    "XK"
  ],
  "build_df_max_frac": 0.005,
  "cap_frac": {
    "EN": 0.002,
    "NT": 0.001,
    "NG": 0.0008,
    "NP": 0.002,
    "PH": 0.002,
    "SK": 0.002,
    "SP": 0.002,
    "NC": 0.002,
    "AT": 0.002,
    "AB": 0.002,
    "XK": 0.002
  },
  "max_postings_per_query": 300000,
  "hand_both": {
    "EN": 10,
    "NT": 1,
    "NG": 1,
    "PH": 0.2,
    "AT": 1
  },
  "channels": {
    "LEARN": "stage1_model",
    "NAME": {
      "EN": 1,
      "NT": 1,
      "NG": 1,
      "PH": 0.2
    },
    "ADDR": {
      "AT": 1,
      "AB": 1
    },
    "PAIR": {
      "NP": 1,
      "SP": 1
    },
    "XK": {
      "XK": 1
    },
    "CAT": {
      "NC": 1
    }
  },
  "quota": {
    "LEARN": 150,
    "NAME": 0,
    "ADDR": 50,
    "PAIR": 100,
    "XK": 50,
    "CAT": 20
  },
  "chain_rule": {
    "enabled": false,
    "min_chain": 10,
    "mult": 2,
    "channels": [
      "ADDR",
      "PAIR",
      "XK"
    ]
  },
  "edge_tokens": {
    "min_frac": 0.0005,
    "min_edge_share": 0.8,
    "nc_min_len": 6,
    "nc_pool_token_min_len": 8
  },
  "stage1_model": {
    "neg_top": 300,
    "neg_rand": 300,
    "C": 1.0,
    "max_iter": 2000
  },
  "rerank": {
    "sample": {
      "top_neg": 100,
      "rand_neg": 100
    },
    "lgb": {
      "objective": "binary",
      "learning_rate": 0.05,
      "num_leaves": 63,
      "min_data_in_leaf": 200,
      "feature_fraction": 0.9,
      "bagging_fraction": 0.8,
      "bagging_freq": 1,
      "lambda_l2": 1.0,
      "max_bin": 255,
      "seed": 42,
      "deterministic": true,
      "force_row_wise": true,
      "num_boost_round": 400,
      "early_stopping_rounds": 50,
      "holdout_frac": 0.1
    },
    "cut": {
      "K_min": 5,
      "K_max": 60,
      "p_min": 0.05
    },
    "cut_grid": {
      "K_min": [
        5,
        10,
        20
      ],
      "K_max": [
        60,
        80,
        100,
        150
      ],
      "p_min": [
        0.0005,
        0.001,
        0.002,
        0.005,
        0.01,
        0.02,
        0.05
      ]
    },
    "mean_size_budget": 100
  },
  "tuned_by": {
    "abbrev_mining.enabled": {
      "experiment": "E0",
      "metrics": "artifacts/metrics/e0_abbrev.json",
      "value": true
    },
    "families": {
      "experiment": "E2",
      "metrics": "artifacts/metrics/s1_E2.json",
      "value": [
        "EN",
        "NT",
        "NG",
        "NP",
        "SP",
        "NC",
        "AT",
        "AB",
        "XK"
      ]
    },
    "cap_frac.NT": {
      "experiment": "E3",
      "metrics": "artifacts/metrics/s1_E3.json",
      "value": 0.001
    },
    "cap_frac.NG": {
      "experiment": "E3",
      "metrics": "artifacts/metrics/s1_E3.json",
      "value": 0.0008
    },
    "cap_frac.AT": {
      "experiment": "E3",
      "metrics": "artifacts/metrics/s1_E3.json",
      "value": 0.002
    },
    "cap_frac.NP": {
      "experiment": "E3",
      "metrics": "artifacts/metrics/s1_E3.json",
      "value": 0.002
    },
    "cap_frac.SP": {
      "experiment": "E3",
      "metrics": "artifacts/metrics/s1_E3.json",
      "value": 0.002
    },
    "cap_frac.AB": {
      "experiment": "E3",
      "metrics": "artifacts/metrics/s1_E3.json",
      "value": 0.002
    },
    "cap_frac.XK": {
      "experiment": "E3",
      "metrics": "artifacts/metrics/s1_E3.json",
      "value": 0.002
    },
    "channels.LEARN": {
      "experiment": "E3b",
      "metrics": "artifacts/metrics/s1_E3b.json",
      "value": "stage1_model"
    },
    "quota": {
      "experiment": "E4",
      "metrics": "artifacts/metrics/s1_E4.json",
      "value": {
        "LEARN": 150,
        "NAME": 0,
        "ADDR": 50,
        "PAIR": 100,
        "XK": 50,
        "CAT": 20
      }
    },
    "chain_rule.enabled": {
      "experiment": "E5",
      "metrics": "artifacts/metrics/s1_E5.json",
      "value": false
    },
    "rerank.cut.K_min": {
      "experiment": "revert: teammate's ADDRESS_EXPERIMENTS.md S4 already measured K_min widening (ceiling +0.002 past K=5, not worth it); K_min stays 5, keep the matcher feature gain instead (k5_feat vs k5_base OOF +0.00211 CI[0.00190,0.00235])",
      "metrics": "artifacts/metrics/rerank_cut.json",
      "value": 5
    },
    "rerank.cut.K_max": {
      "experiment": "rerank-cut",
      "metrics": "artifacts/metrics/rerank_cut.json",
      "value": 60
    },
    "rerank.cut.p_min": {
      "experiment": "rerank-cut",
      "metrics": "artifacts/metrics/rerank_cut.json",
      "value": 0.05
    }
  }
}
